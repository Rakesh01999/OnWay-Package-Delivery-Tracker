# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/onway-delivery-tracker

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1d

# CORS (frontend origin; use * for local dev)
CORS_ORIGIN=*

# Seed defaults
SEED_EMAIL=staff@onway.com
SEED_PASSWORD=password123