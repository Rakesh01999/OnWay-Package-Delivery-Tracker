{
    "name": "onway-delivery-tracker-backend",
    "version": "1.0.0",
    "description": "Onway Package Delivery Tracker - Hono.js + MongoDB backend",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/dev.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "seed": "tsx src/scripts/seed.ts",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@hono/node-server": "^1.13.3",
        "@hono/zod-validator": "^0.4.1",
        "bcryptjs": "^2.4.3",
        "dotenv": "^16.4.5",
        "hono": "^4.6.3",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.7.1",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/node": "^22.7.4",
        "mongodb-memory-server": "^10.0.1",
        "tsx": "^4.19.1",
        "typescript": "^5.6.3",
        "vitest": "^2.1.2"
    }
}